# GitHub OAuth Configuration
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_generate_with_openssl

# Ollama Cloud API Keys (comma-separated for rotation)
OLLAMA_API_KEYS=ollama_key1,ollama_key2,ollama_key3

# Mistral Cloud API Keys (comma-separated for rotation)
MISTRAL_API_KEYS=mistral_key1,mistral_key2

# Redis for Threat Intelligence Cache (Optional - uses in-memory fallback if not provided)
# Option 1: Upstash Redis (Recommended for Vercel/Serverless)
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# Option 2: Standard Redis (For traditional hosting)
# REDIS_URL=redis://localhost:6379
# REDIS_URL=rediss://default:password@host:port

# ==============================================
# CONVEX DATABASE (Get from: https://dashboard.convex.dev)
# ==============================================
# Run `npx convex dev` to get your deployment URL
CONVEX_DEPLOYMENT=production:your-deployment-name
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# ==============================================
# DODO PAYMENTS (Get from: https://dashboard.dodopayments.com)
# ==============================================
# API Keys → Create Secret Key
DODO_API_KEY=test_sk_your_secret_key_here

# Webhooks → Signing Secret
DODO_PAYMENTS_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# API Keys → Publishable Key
NEXT_PUBLIC_DODO_PUBLIC_KEY=test_pk_your_publishable_key_here

# Optional: Set to 'production' in production
NODE_ENV=development
