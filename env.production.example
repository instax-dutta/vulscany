# Production Environment Variables for https://vlsn.sdad.pro

# GitHub OAuth (Update with production OAuth app)
GITHUB_CLIENT_ID=your_production_github_client_id
GITHUB_CLIENT_SECRET=your_production_github_client_secret
NEXT_PUBLIC_GITHUB_CLIENT_ID=your_production_github_client_id

# NextAuth
NEXTAUTH_URL=https://vullscanny.sdad.pro
NEXTAUTH_SECRET=generate_new_secret_for_production

# AI API Keys (Use production keys)
OLLAMA_API_KEYS=prod_key1,prod_key2,prod_key3
MISTRAL_API_KEYS=prod_keyA,prod_keyB

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://vlsn.sdad.pro
NODE_ENV=production
